# ---------------------------------------------------------------------------
# Poin't & Polish — Environment Variables
# Copy this file to `.env.local` and fill in real values. NEVER commit secrets.
# ---------------------------------------------------------------------------

# App -----------------------------------------------------------------------
# Public base URL of the deployed app (no trailing slash). Used for links in
# emails and OAuth redirects. Use http://localhost:3000 in development.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase ------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API.
# The URL and anon/publishable key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Service-role key: SERVER ONLY. Bypasses Row Level Security.
# Never expose this to the client or commit it. Used by trusted server actions,
# route handlers, and cron jobs only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Calendar OAuth (Phase 5) -------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:3000/api/google/callback

# Resend email (Phase 5) ----------------------------------------------------
RESEND_API_KEY=your-resend-api-key
# The verified "from" address for outgoing email.
EMAIL_FROM="Poin't & Polish <bookings@example.com>"

# Cron (Phase 5) ------------------------------------------------------------
# Shared secret used to authorize Vercel Cron requests to reminder endpoints.
CRON_SECRET=generate-a-long-random-string
