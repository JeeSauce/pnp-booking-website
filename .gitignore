# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local secret scratch files — NEVER commit
pnp-booking-keys.txt
pnp-booking-keys-and-tokens.txt
*keys*.txt
*secrets*.txt

# supabase local
/supabase/.branches
/supabase/.temp

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
